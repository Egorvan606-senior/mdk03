<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ПК № 20, вариант 10. ИС «Умный кампус».
    АРМ дежурного инженера столовой: мониторинг доступности API выгрузки транзакций,
    экспорт ведомости питания по категориям льгот (CSV), структурированный лог Serilog.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CampusArmMonitor</RootNamespace>
    <AssemblyName>CampusArmMonitor</AssemblyName>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serilog: ядро + два приёмника (Dual Sinks): консоль и локальный файл с ротацией -->
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
