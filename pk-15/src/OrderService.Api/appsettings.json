{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OrderService.Waf": "Information"
    }
  },
  "ConnectionStrings": {
    "Orders": "Data Source=orders.db"
  },
  "Payments": {
    // NewGateway3DS2 — новый шлюз (релиз 2.0.0); Legacy — старый шлюз (быстрый откат конфигурацией)
    "Provider": "NewGateway3DS2",
    // Только для учебного стенда: имитация зависания шлюза (инцидент 504 из Runbook RB-001)
    "SimulateTimeout": false
  },
  "Waf": {
    // Режим как у ModSecurity SecRuleEngine: On — блокировать, DetectionOnly — только журналировать, Off — выключен
    "Mode": "On",
    "MaxBodyBytes": 65536
  },
  "AllowedHosts": "*"
}
