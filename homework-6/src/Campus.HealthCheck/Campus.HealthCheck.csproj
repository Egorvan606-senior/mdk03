<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тестер Health Check после обновления АРМ оператора ИС «Умный кампус».
    Практическая работа № 6, вариант 10. Только стандартная библиотека .NET 8:
    утилиту можно скопировать на АРМ без установки дополнительных пакетов.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Campus.HealthCheck</RootNamespace>
    <AssemblyName>campus-healthcheck</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="healthcheck.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
