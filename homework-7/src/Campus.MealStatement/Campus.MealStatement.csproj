<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Генератор ведомости питания (финансовый лог столовой) ИС «Умный кампус».
    Практическая работа № 7, вариант 10. Только стандартная библиотека .NET 8.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Campus.MealStatement</RootNamespace>
    <AssemblyName>campus-meal-statement</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mealstatement.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
